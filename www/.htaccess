# senzorvzduchu.cz — kořen webu (3.5 PWA + 3.6 push). Nahrát FTP, hned ověřit, že /map/ funguje.

# PWA (3.5): složka .well-known (Digital Asset Links) nesmí být blokovaná jako „tečková"
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.well-known/ - [L]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^(manifest\.json|assetlinks\.json)$">
    Header set Content-Type "application/json; charset=utf-8"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# 3.6: databáze a zámky nikdy nesmí být ke stažení (push.db = adresy odběrů push upozornění;
# air_quality_history.db byla do 3.6 veřejně čitelná — není tajná, ale ani není k stahování).
<FilesMatch "\.(db|db-wal|db-shm|sqlite|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
